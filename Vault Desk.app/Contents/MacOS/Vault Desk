#!/bin/bash
# Opens Vault Desk in your browser.
# If the server isn't running, starts it first.
ROOT="$(cd "$(dirname "$0")/../../.." && pwd)"
URL="http://127.0.0.1:7423"

if curl -s -o /dev/null -w "%{http_code}" "$URL" 2>/dev/null | grep -q "200"; then
  open "$URL"
  exit 0
fi

if launchctl list com.vaultdesk.server &>/dev/null; then
  launchctl start com.vaultdesk.server 2>/dev/null || true
else
  osascript -e "display alert \"Vault Desk\" message \"Server is not running. Open Terminal in the vault-desk folder and run: npm run setup\""
  exit 1
fi

for i in $(seq 1 10); do
  sleep 1
  if curl -s -o /dev/null -w "%{http_code}" "$URL" 2>/dev/null | grep -q "200"; then
    open "$URL"
    exit 0
  fi
done

open "$URL"
